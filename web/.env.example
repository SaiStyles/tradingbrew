# ─────────────────────────────────────────────
# TradingBrew — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is gitignored.
# ─────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (AI Agents) ─────────────────────
# Used by all 5 Haiku agents in the pipeline.
ANTHROPIC_API_KEY=

# ── OpenAI (STT only) ─────────────────────────
# Used by Whisper STT (/api/stt). TTS removed from chat path.
OPENAI_API_KEY=

# ── Telegram Bot (optional) ──────────────────
# Required only if you want end-of-session Telegram summaries.
# Setup: docs/add-telegram.sql + register webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_WEBHOOK_SECRET=

# ── Hindsight Memory (optional) ──────────────
# Semantic memory layer (gen2 agentic memory by vectorize.io).
# App works without it — Buddy just runs without trader portrait/recall.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=

# ── Cron Secret (Vercel Pro only) ─────────────
# Required for /api/telegram/briefing scheduled job.
CRON_SECRET=
